/* ============================================================
   21. «·≈‘⁄«—« 
   ============================================================ */
.toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--text-primary);
    color: var(--background);
    padding: 14px 28px;
    border-radius: var(--radius-sm);
    z-index: 9999;
    font-size: 15px;
    box-shadow: var(--shadow-hover);
    animation: slideUp 0.4s ease;
    max-width: 90%;
    text-align: center;
    font-weight: 500;
    border: 1px solid var(--border);
}

.toast.success {
    background: var(--success);
    color: white;
}

.toast.error {
    background: var(--danger);
    color: white;
}

.toast.warning {
    background: var(--warning);
    color: white;
}

.toast.info {
    background: var(--primary);
    color: white;
}

@keyframes slideUp {
    from {
        transform: translateX(-50%) translateY(30px);
        opacity: 0;
    }
    to {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }
}

/* ============================================================
   22. «·√“—«— «·Ã«‰»Ì… «·⁄«∆„…
   ============================================================ */
.floating-buttons {
    position: fixed;
    left: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 999;
}

.floating-buttons button {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: none;
    font-size: 22px;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--shadow-hover);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
}

.floating-buttons button:hover {
    transform: scale(1.12);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
}

.floating-buttons button:active {
    transform: scale(0.9);
}

.floating-buttons .btn-scroll { 
    background: var(--primary); 
    color: white;
}

.floating-buttons .btn-theme { 
    background: var(--secondary); 
    color: white;
}

.floating-buttons .btn-stats { 
    background: var(--warning); 
    color: white;
}

.floating-buttons .btn-fav { 
    background: var(--danger); 
    color: white;
}

